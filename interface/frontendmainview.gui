			smooth_scrolling = yes
			background = {
				name = "Background"
				quadTextureSprite ="GFX_tiled_window_transparent"
			}

				gridBoxType = {
					position = { x = 9 y = 0 }
					name = "available_backgrounds"
					size = { width = 200 height = 0 }
					slotsize = { width = 200 height = 150 }
					max_slots_horizontal = 1
				}

			}
		}
